---
import type { SiteContent } from '../content/site';
interface Props { c: SiteContent; lang: 'en' | 'sk' }
const { c, lang } = Astro.props;
const links = [
  { n: '01', id: 'about', label: c.nav.about },
  { n: '02', id: 'record', label: c.nav.record },
  { n: '03', id: 'work', label: c.nav.work },
  { n: '04', id: 'research', label: c.nav.research },
  { n: '05', id: 'summit', label: c.nav.summit },
  { n: '08', id: 'contact', label: c.nav.contact },
];
const homeHref = lang === 'sk' ? '/sk/' : '/';
---
<header id="siteHeader">
  <div class="hdr-brand">
    <a href={homeHref} class="mono-logo" aria-label="Daniel Štorcel">DŠ</a>
    <span class="hdr-index mono" aria-label="01 / 08"><span class="hdr-roll" aria-hidden="true"><span>01 / 08</span><span>01 / 08</span></span></span>
  </div>
  <nav class="desktop-nav" aria-label="Primary">
    {links.map((l) => (
      <a href={`#${l.id}`}><sup class="idx">{l.n}</sup>{l.label}</a>
    ))}
    <span class="nav-ink" aria-hidden="true"></span>
  </nav>
  <div class="right">
    <div class="langs" aria-label="Language / Jazyk">
      <a href="/" class:list={['lang-link', lang === 'en' && 'active']} aria-current={lang === 'en' ? 'true' : undefined}><span class="btn-label"><span>EN</span><span aria-hidden="true">EN</span></span></a>
      <span>/</span>
      <a href="/sk/" class:list={['lang-link', lang === 'sk' && 'active']} aria-current={lang === 'sk' ? 'true' : undefined}><span class="btn-label"><span>SK</span><span aria-hidden="true">SK</span></span></a>
    </div>
    <a class="cv-pill" href={c.cvHref} target="_blank" rel="noopener" data-magnetic><span class="btn-label"><span>{c.cvLabel}</span><span aria-hidden="true">{c.cvLabel}</span></span></a>
    <button id="burger" class="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
  </div>
</header>

<nav id="mobileMenu" aria-label="Mobile" role="dialog" aria-modal="true">
  {links.map((l) => (
    <a href={`#${l.id}`}><span class="m-idx mono">{l.n}</span><span class="m-label">{l.label}</span></a>
  ))}
</nav>

<style>
  #siteHeader {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--gutter);
    mix-blend-mode: difference;
    color: #f3efe7;
    transition: transform 0.5s var(--ease-out);
  }
  #siteHeader.is-hidden { transform: translateY(-110%); }
  .hdr-brand { display: flex; align-items: center; gap: 16px; }
  .hdr-index { display: block; height: 1.2em; line-height: 1.2; overflow: hidden; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hdr-roll, .hdr-roll span { display: block; }
  .mono-logo {
    font-family: var(--font-display), serif;
    font-style: italic;
    font-size: 22px;
    letter-spacing: 0.02em;
  }
  .desktop-nav { position: relative; display: flex; gap: clamp(14px, 2.4vw, 34px); }
  .nav-ink { position: absolute; left: 0; bottom: -7px; height: 1px; width: 0; background: var(--accent); pointer-events: none; }
  .desktop-nav a {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
    transition: opacity 0.3s;
  }
  .desktop-nav a:hover { opacity: 1; }
  .desktop-nav a.nav-active { opacity: 1; }
  .desktop-nav a.nav-active .idx { color: var(--accent); opacity: 1; }
  .desktop-nav .idx { font-size: 8px; margin-right: 5px; opacity: 0.5; }
  .right { display: flex; align-items: center; gap: 18px; }
  .langs {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    display: flex;
    gap: 6px;
  }
  .langs a { opacity: 0.55; }
  .langs a.active { opacity: 1; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .cv-pill {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 8px 18px;
    display: inline-block;
  }
  .burger { display: none; background: none; border: 0; width: 30px; height: 20px; position: relative; color: inherit; cursor: pointer; }
  .burger span { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; transition: transform .35s var(--ease-out), top .35s; }
  .burger span:first-child { top: 4px; }
  .burger span:last-child { top: 14px; }
  .burger.open span:first-child { top: 9px; transform: rotate(45deg); }
  .burger.open span:last-child { top: 9px; transform: rotate(-45deg); }

  #mobileMenu {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: var(--ink);
    color: var(--text);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
    gap: 6px;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.6s var(--ease-out), visibility 0.6s;
  }
  #mobileMenu.open { clip-path: inset(0 0 0% 0); visibility: visible; }
  #mobileMenu a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-family: var(--font-display), serif;
    font-size: clamp(44px, 11vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .m-idx { font-size: 11px; color: var(--accent); }

  @media (max-width: 820px) {
    .desktop-nav { display: none; }
    .burger { display: block; }
    .cv-pill { display: none; }
  }
</style>
