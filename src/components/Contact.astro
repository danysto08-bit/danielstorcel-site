---
import type { SiteContent } from '../content/site';
import GhostIndex from './GhostIndex.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
const { contact } = c;
const sitemap = Object.entries(c.nav) as [keyof SiteContent['nav'], string][];
const contactPlanks = [
  { id: 'email', label: contact.email, href: `mailto:${contact.email}`, tag: contact.signpost.tags.write },
  { id: 'instagram', label: contact.instagram, href: contact.instagramUrl, tag: contact.signpost.tags.follow },
  { id: 'cv', label: 'CV', href: c.cvHref, tag: contact.signpost.tags.pdf },
];
const compass = (bearing: number) => ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.floor((bearing + 22.5) / 45) % 8];
const distance = (km: number) => `${String(km).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} km`;
---
<section id="contact" data-theme="accent" class="contact">
  <GhostIndex value="08" />
  <div class="contact-glow a" aria-hidden="true"></div>
  <div class="contact-glow b" aria-hidden="true"></div>
  <div class="wrap contact-wrap">
    <div class="sec-head">
      <span class="mono index">{contact.index}</span>
      <span class="mono">— {c.nav.contact}</span>
    </div>
    <div class="contact-main">
      <div class="contact-intro">
        <h2 class="contact-headline" data-reveal-lines>
          <span class="mask-line"><span>{contact.headline[0]}</span></span>
          <span class="mask-line"><span class="italic">{contact.headline[1]}</span></span>
        </h2>
        <p class="contact-sub">{contact.sub}</p>
      </div>
      <div class="signpost">
        <div class="signpost-shaft" aria-hidden="true"></div>
        <div class="signpost-cap" aria-hidden="true"></div>
        <ol class="signpost-list">
          {contactPlanks.map((item, i) => (
            <li class:list={['plank-row', i % 2 === 0 ? 'is-right' : 'is-left']}>
              <div class="plank-motion">
                <a class:list={['plank', 'is-filled', i % 2 === 0 ? 'plank-right' : 'plank-left']} id={item.id === 'email' ? 'emailLink' : undefined} data-id={item.id} data-email={item.id === 'email' ? contact.email : undefined} data-copied={item.id === 'email' ? contact.copied : undefined} href={item.href} target={item.id === 'email' ? undefined : '_blank'} rel={item.id === 'email' ? undefined : 'noopener'}>
                  <span class:list={['plank-name', item.id === 'email' && 'email-flip']}>{item.label}</span>
                  <span class="plank-tag">{item.tag}</span>
                </a>
              </div>
            </li>
          ))}
          {contact.signpost.places.map((place, index) => {
            const right = (index + contactPlanks.length) % 2 === 0;
            return (
              <li class:list={['plank-row', right ? 'is-right' : 'is-left']}>
                <div class="plank-motion">
                  <div class:list={['plank', right ? 'plank-right' : 'plank-left', place.mark === 'home' && 'is-filled', place.mark === 'home' && 'is-home']} tabindex="0" data-id={place.id}>
                    <span class="plank-name">{place.name}</span>
                    <span class="plank-meta">{compass(place.bearing)} {place.bearing.toFixed(1)}° · {distance(place.km)}</span>
                    {place.mark && <span class="plank-tag">{place.mark === 'climbed' ? `✓ ${contact.signpost.tags.climbed}` : contact.signpost.tags.home}{place.mark === 'home' && <span class="home-clock"></span>}</span>}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
        <div class="signpost-ground" aria-hidden="true"></div>
        <p class="signpost-hint mono">{contact.signpost.hint}</p>
        <span id="copyToast" class="sr-only" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
  <footer class="contact-footer">
    <div class="wrap">
      <div class="footer-row footer-primary mono">
        <span>{contact.footerName} · {contact.footerPlace}</span>
        <span id="localTime" role="timer"><span class="clock-hm" aria-hidden="true"></span><span class="clock-seconds-window" aria-hidden="true"><span class="clock-seconds-roll"><span>00</span><span>00</span></span></span></span>
        <span class="contact-weather" hidden data-label={contact.weather.label} data-wind={contact.weather.wind} data-codes={JSON.stringify(contact.weather.codes)}></span>
        <span>{contact.built}</span>
      </div>
      <div class="footer-row footer-secondary mono">
        <nav class="footer-sitemap" aria-label="Sitemap">{sitemap.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
        <span class="footer-languages"><a href="/" aria-current={c.htmlLang === 'en' ? 'true' : undefined}>EN</a> / <a href="/sk/" aria-current={c.htmlLang === 'sk' ? 'true' : undefined}>SK</a></span>
        <span>© 2026</span>
        <a href="#top" id="backToTop"><span class="btn-label"><span>{contact.backToTop}</span><span aria-hidden="true">{contact.backToTop}</span></span></a>
      </div>
    </div>
  </footer>
</section>

<style>
  .contact { min-height: 100svh; display: flex; flex-direction: column; padding-block: clamp(72px, 7vw, 104px) 0; overflow: clip; color: var(--accent-ink); }
  .contact-glow { position: absolute; width: 60vw; height: 60vw; border-radius: 50%; filter: blur(80px); mix-blend-mode: multiply; pointer-events: none; z-index: 0; }
  .contact-glow.a { top: -15%; left: -15%; background: radial-gradient(circle, rgba(255,120,80,.55), transparent 70%); animation: glow-a 24s ease-in-out infinite alternate; }
  .contact-glow.b { right: -15%; bottom: -20%; background: radial-gradient(circle, rgba(160,30,0,.45), transparent 70%); animation: glow-b 31s ease-in-out infinite alternate; }
  @keyframes glow-a { from { transform: translate(-12%, -12%); } to { transform: translate(12%, 12%); } }
  @keyframes glow-b { from { transform: translate(12%, -12%); } to { transform: translate(-12%, 12%); } }
  .contact .wrap { width: 100%; max-width: 1440px; margin: 0 auto; }
  .sec-head { display: flex; gap: 14px; align-items: baseline; border-top: 1px solid var(--line-c); padding-top: 18px; margin-bottom: clamp(32px, 4vw, 56px); }
  .index { color: var(--accent-ink); }
  .contact-main { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 4vw, 64px); align-items: center; padding-bottom: clamp(56px, 7vw, 96px); }
  .contact-headline { font-family: var(--font-display), serif; font-weight: 400; font-size: clamp(50px, 5.5vw, 82px); line-height: .94; letter-spacing: -.02em; }
  .italic { font-style: italic; }
  .contact-headline.is-revealed :global(.mask-line) { overflow: visible; }
  .contact-sub { margin-top: 18px; font-size: clamp(15px, 1.25vw, 18px); line-height: 1.5; }
  .signpost { position: relative; width: 100%; max-width: 760px; justify-self: center; padding-top: 14px; --sway: 0deg; }
  .signpost-shaft { position: absolute; top: 0; bottom: 34px; left: 50%; width: 2px; background: var(--accent-ink); transform-origin: top; }
  .signpost-cap { position: absolute; top: 0; left: calc(50% - 2px); width: 6px; height: 6px; background: var(--accent-ink); }
  .signpost-list { position: relative; display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .plank-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .plank-row.is-right .plank-motion { grid-column: 2; justify-self: start; }
  .plank-row.is-left .plank-motion { grid-column: 1; justify-self: end; }
  .plank-motion { max-width: 100%; }
  .plank { position: relative; isolation: isolate; display: flex; align-items: center; gap: 8px; width: max-content; min-width: 220px; max-width: 100%; height: 40px; padding: 0 20px; color: var(--accent-ink); transform: rotate(var(--sway)); transition: transform .35s var(--ease-out); }
  .plank::before, .plank::after { content: ''; position: absolute; pointer-events: none; clip-path: var(--plank-shape); }
  .plank::before { inset: 0; z-index: -2; background: var(--accent-ink); }
  .plank::after { inset: 1px; z-index: -1; background: var(--accent); }
  .plank-right { --plank-shape: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%); --hover-x: 6px; --hover-rotation: 1.5deg; transform-origin: left center; }
  .plank-left { --plank-shape: polygon(14px 0, 100% 0, 100% 100%, 14px 100%, 0 50%); --hover-x: -6px; --hover-rotation: -1.5deg; flex-direction: row-reverse; transform-origin: right center; }
  .plank.is-filled { color: var(--accent); }
  .plank.is-filled::after { background: var(--accent-ink); }
  .plank:hover, .plank:focus-visible { transform: translateX(var(--hover-x)) rotate(calc(var(--sway) + var(--hover-rotation))); }
  .plank:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 3px; }
  a.plank { cursor: pointer; }
  .plank-name { flex: 0 1 auto; min-width: 0; font-family: var(--font-display), serif; font-size: clamp(17px, 1.35vw, 22px); line-height: 1; white-space: nowrap; }
  .email-flip { display: inline-block; transform-origin: 50% 50%; }
  .plank-meta, .plank-tag { font-family: var(--font-mono), monospace; font-size: 9px; line-height: 1.2; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
  .plank-tag { border: 1px solid currentColor; padding: 2px 3px; }
  .plank:not(.is-filled):is(:hover, :focus-visible) .plank-tag { background: var(--accent-ink); color: var(--accent); }
  .plank.is-filled:is(:hover, :focus-visible) .plank-tag { background: var(--accent); color: var(--accent-ink); }
  .home-clock { margin-left: 4px; font-variant-numeric: tabular-nums; }
  .signpost-ground { width: 72px; height: 1px; background: var(--accent-ink); margin: 14px auto 0; }
  .signpost-hint { margin-top: 13px; text-align: center; color: var(--accent-ink); opacity: .7; }
  .contact-footer { position: relative; z-index: 1; margin-top: auto; border-top: 1px solid var(--line-c); padding: 20px 0; }
  .footer-row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px 24px; flex-wrap: wrap; color: var(--accent-ink); }
  .footer-secondary { margin-top: 20px; }
  .footer-sitemap { display: flex; gap: 10px 16px; flex-wrap: wrap; }
  .footer-row a { text-decoration: underline; text-underline-offset: 4px; }
  .footer-languages a[aria-current] { font-weight: 700; }
  #localTime { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .clock-seconds-window { display: inline-block; height: 1.2em; line-height: 1.2; overflow: hidden; vertical-align: bottom; }
  .clock-seconds-roll, .clock-seconds-roll span { display: block; }
  @media (max-width: 1280px) and (min-width: 1024px) {
    .signpost { --post-x: clamp(220px, calc(50% + 25vw - 320px), 50%); }
    .signpost-shaft { left: var(--post-x); }
    .signpost-cap { left: calc(var(--post-x) - 2px); }
    .plank-row { grid-template-columns: minmax(0, var(--post-x)) minmax(0, 1fr); }
    .plank-motion { min-width: 220px; }
    .plank { height: 36px; gap: 5px; padding-inline: 16px; }
    .plank-meta, .plank-tag { letter-spacing: 0; }
    .signpost-ground { margin-left: calc(var(--post-x) - 36px); margin-right: 0; }
    .signpost-hint { position: relative; left: calc(var(--post-x) - 50%); }
  }
  @media (max-width: 1023px) {
    .contact-main { display: flex; flex-direction: column; align-items: stretch; }
    .signpost { max-width: none; }
    .signpost-shaft { left: 14px; }
    .signpost-cap { left: 12px; }
    .plank-row { grid-template-columns: 14px minmax(0, 1fr); }
    .plank-row.is-left .plank-motion, .plank-row.is-right .plank-motion { grid-column: 2; justify-self: stretch; width: calc(100% - 14px); }
    .plank { width: 100%; min-width: 0; height: 40px; }
    .plank-left { --plank-shape: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%); --hover-x: 6px; --hover-rotation: 1.5deg; flex-direction: row; transform-origin: left center; }
    .signpost-ground { margin-left: 0; }
    .signpost-hint { text-align: left; }
    .footer-row { justify-content: flex-start; }
  }
  @media (max-width: 820px) {
    .contact-headline { font-size: clamp(40px, 11vw, 64px); }
    .footer-row { flex-direction: column; align-items: flex-start; }
    .footer-sitemap { gap: 10px 14px; }
  }
  @media (max-width: 390px) {
    .plank { height: auto; min-height: 40px; flex-wrap: wrap; padding-block: 8px; }
    .plank-name { font-size: 16px; }
  }
</style>
