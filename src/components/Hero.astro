---
import { Picture } from 'astro:assets';
import type { SiteContent } from '../content/site';
import heroImg from '../assets/hero-daniel.jpg';
interface Props { c: SiteContent }
const { c } = Astro.props;
const tickerItems = [...c.hero.ticker, ...c.hero.ticker, ...c.hero.ticker];
---
<section class="hero" data-theme="ink">
  <div class="hero-body">
    <div class="hero-photo-frame">
      <Picture src={heroImg} alt={c.hero.photoAlt} formats={['avif', 'webp']} widths={[800, 1400, 2200]} sizes="(min-width: 821px) 66vw, 100vw" loading="eager" data-velocity-skew />
      <span class="hero-photo-border" aria-hidden="true"></span>
    </div>
    <div class="hero-inner">
      <p class="hero-eyebrow mono"><span class="dot"></span>{c.hero.eyebrow}</p>
      <h1 class="hero-name">
        <span class="line-wrap"><span class="line-1">{c.hero.nameFirst}</span></span>
        <span class="line-wrap"><span class="line-2">{c.hero.nameLast}</span></span>
      </h1>
      <p class="hero-intro" set:html={c.hero.intro} />
      <p class="hero-tags mono">{c.hero.tags.join(' · ')}</p>
      <div class="hero-ctas">
        <a class="btn-primary" href={c.cvHref} target="_blank" rel="noopener" data-magnetic><span class="btn-label"><span>{c.hero.primaryCta}</span><span aria-hidden="true">{c.hero.primaryCta}</span></span></a>
        <a class="btn-ghost" href="#record"><span class="btn-label"><span>{c.hero.ghostCta}</span><span aria-hidden="true">{c.hero.ghostCta}</span></span></a>
      </div>
    </div>
  </div>
  <ul class="sr-only">
    {c.hero.ticker.map((t) => <li>{t}</li>)}
  </ul>
  <div class="hero-ticker" aria-hidden="true">
    <div class="ticker-track">
      {tickerItems.map((t) => <span>{t}&ensp;✦&ensp;</span>)}
    </div>
  </div>
</section>

<style>
  .hero {
    --ticker-h: 44px;
    padding-block: 0;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
  }
  .hero-body {
    position: relative;
    flex: 1;
    min-height: calc(100svh - var(--ticker-h));
    display: flex;
  }
  .hero-photo-frame {
    position: absolute;
    top: 88px;
    right: 0;
    bottom: 0;
    width: 66%;
    clip-path: inset(0 0 100% 0);
    z-index: 0;
    overflow: hidden;
  }
  .js .hero-photo-frame { clip-path: inset(0 0 100% 0); }
  .hero-photo-border {
    position: absolute;
    inset: clamp(12px, 1.6vw, 24px);
    border: 1px solid var(--paper);
    opacity: 0.35;
    pointer-events: none;
    z-index: 3;
  }
  .hero-photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .hero.has-gl .hero-photo-frame :global(img) { visibility: hidden; }
  .hero-photo-frame :global(.hero-gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(100px, 14vh, 160px) var(--gutter) clamp(48px, 6vh, 80px);
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; }
  .hero-eyebrow .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 79, 31, 0.5); }
    50% { box-shadow: 0 0 0 7px rgba(255, 79, 31, 0); }
  }
  .hero-name {
    font-family: var(--font-display), serif;
    font-weight: 400;
    font-size: var(--display-xl);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 0.12em 0 0.28em;
  }
  .line-wrap { display: block; overflow: hidden; perspective: 900px; }
  .line-wrap + .line-wrap { padding-top: 0.12em; }
  .line-1, .line-2 { display: block; }
  .line-2 { font-style: italic; color: var(--accent); }
  .hero-intro {
    max-width: 46ch;
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .hero-intro :global(b) { font-weight: 500; color: var(--fg); }
  .hero-tags { margin-top: 26px; color: var(--fg-faint); }
  .hero-ctas { display: flex; gap: 14px; margin-top: 38px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 28px;
    display: inline-block;
  }
  .btn-ghost {
    border: 1px solid var(--line-c);
    color: var(--fg);
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 28px;
    display: inline-block;
    transition: border-color 0.3s;
  }
  .btn-ghost:hover { border-color: var(--fg); }
  .hero-ticker {
    border-top: 1px solid var(--line-c);
    border-bottom: 1px solid var(--line-c);
    overflow: hidden;
    height: var(--ticker-h);
    display: flex;
    align-items: center;
  }
  .ticker-track {
    display: flex;
    white-space: nowrap;
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    animation: marquee 40s linear infinite;
    width: max-content;
  }
  .hero-ticker:hover .ticker-track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-33.333%); } }

  @media (min-width: 821px) {
    .hero-inner { padding-block: clamp(88px, 10vh, 120px) clamp(24px, 3vh, 40px); }
  }
  @media (min-width: 1024px) {
    .hero-inner {
      width: min(52%, 748.8px);
      margin-left: max(0px, calc((100% - 1440px) / 2));
      margin-right: 0;
      z-index: 2;
    }
    .hero-name { width: max-content; }
    .line-2 { margin-left: -0.02em; }
    .hero-photo-frame { right: 8%; }
    .hero-photo-frame::after {
      content: '';
      position: absolute; inset: 0 auto 0 0; width: 58%;
      background: linear-gradient(90deg, var(--ink) 0%, var(--ink) 40%, transparent 100%);
      opacity: .9; pointer-events: none; z-index: 2;
    }
  }
  @media (max-width: 820px) {
    .hero { --ticker-h: 40px; }
    .hero-photo-frame { width: 100%; top: 0; opacity: 0.4; }
    .hero-photo-frame::before {
      content: '';
      position: absolute; inset: 0; z-index: 1;
      background: linear-gradient(to right, var(--bg) 10%, rgba(12,12,13,.55) 60%, transparent 95%),
                  linear-gradient(to top, var(--bg) 18%, transparent 70%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
    .hero-eyebrow .dot { animation: none; }
  }
</style>
