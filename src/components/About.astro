---
import { Picture } from 'astro:assets';
import type { SiteContent } from '../content/site';
import harborImg from '../assets/about-harbor.jpg';
import GhostIndex from './GhostIndex.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
---
<section id="about" data-theme="graphite" class="about section-grid">
  <GhostIndex value="01" />
  <div class="wrap">
    <div class="sec-head">
      <span class="mono index">{c.about.index}</span>
      <span class="mono" data-reveal-lines><span class="mask-line"><span>— {c.about.title}</span></span></span>
    </div>
    <p class="about-statement">{c.about.statement}</p>
    <div class="about-cols">
      <ul class="interest-list">
        {c.about.interests.map((i) => (
          <li>
            <span class="i-line" aria-hidden="true"></span>
            <span class="i-label">{i.label}</span>
            <span class="i-tag mono">{i.tag}</span>
          </li>
        ))}
      </ul>
      <div class="about-right">
        <p class="about-p2">{c.about.paragraph2}</p>
        <p class="traits mono">{c.about.traits.join(', ')}</p>
      </div>
    </div>
    <figure class="about-photo photo-frame">
      <div class="about-media">
        <Picture src={harborImg} alt={c.about.photoAlt} formats={['avif', 'webp']} widths={[800, 1400, 2200]} sizes="100vw" loading="lazy" data-velocity-skew />
        <span class="glare" aria-hidden="true"></span>
      </div>
      <figcaption class="mono">{c.about.photoCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .about .wrap { position: relative; z-index: 1; }
  .about .sec-head {
    display: flex;
    gap: 14px;
    align-items: baseline;
    border-top: 1px solid var(--line-c);
    padding-top: 18px;
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .index { color: var(--accent); }
  .about-statement {
    font-family: var(--font-display), serif;
    font-size: var(--display-m);
    line-height: 1.18;
    letter-spacing: -0.01em;
    max-width: min(1100px, 78vw);
    margin-bottom: clamp(56px, 8vw, 110px);
  }
  .about-cols {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 5vw, 90px);
    margin-bottom: clamp(56px, 8vw, 110px);
  }
  .interest-list { list-style: none; }
  .interest-list li {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 0;
  }
  .interest-list li:last-child { border-bottom: 1px solid var(--line-c); }
  .i-line { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--line-c); transform-origin: left; }
  .i-label { font-size: clamp(17px, 1.5vw, 21px); font-weight: 400; }
  .i-tag { color: var(--fg-faint); }
  .about-p2 {
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.65;
    color: var(--fg-dim);
    max-width: 52ch;
  }
  .traits { margin-top: 28px; color: var(--fg-faint); line-height: 2; }
  .about-photo {
    clip-path: inset(12% 8% 12% 8%);
    perspective: 1200px;
  }
  .about-media {
    position: relative;
    overflow: hidden;
  }
  .about-photo :global(img) { width: 100%; height: auto; }
  .glare {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255,255,255,.14), transparent 55%);
  }
  .about-photo figcaption { position: relative; margin-top: 12px; color: var(--fg-faint); }
  @media (max-width: 820px) {
    .about-cols { grid-template-columns: 1fr; }
    .about-statement { max-width: none; }
  }
</style>
