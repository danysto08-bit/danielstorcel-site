---
import type { SiteContent } from '../content/site';
import GhostIndex from './GhostIndex.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
---
<section id="experience" data-theme="graphite" class="experience section-grid">
  <GhostIndex value="07" />
  <div class="wrap exp-wrap">
    <div class="sec-head">
      <span class="mono index">{c.sections.experience.index}</span>
      <span class="mono">— {c.sections.experience.title}</span>
    </div>
    <h2 class="exp-title" data-reveal-lines>
      <span class="mask-line"><span>{c.sections.experience.title}</span></span>
    </h2>
    <div class="xp-timeline">
      <div class="xp-rail" aria-hidden="true"><div class="xp-rail-fill"></div></div>
      <div class="xp-columns">
        {c.experience.map((e, i) => (
          <article class="xp-column" tabindex="0">
            <div class="xp-role mono"><span class="xp-index">{String(i + 1).padStart(2, '0')}</span><span>{e.role}</span></div>
            <span class="xp-node" aria-hidden="true"></span>
            <h3 class="xp-name">{e.title}</h3>
            <p class="xp-desc">{e.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience { --grid-wrap: 960px; --ghost-wrap: 960px; padding-block: clamp(72px, 9vw, 120px); }
  .exp-wrap { max-width: 960px; }
  .sec-head {
    display: flex; gap: 14px; align-items: baseline;
    border-top: 1px solid var(--line-c);
    padding-top: 18px;
    margin-bottom: 32px;
  }
  .index { color: var(--accent); }
  .exp-title {
    font-family: var(--font-display), serif;
    font-weight: 400;
    font-size: var(--display-l);
    letter-spacing: -0.01em;
    margin-bottom: 40px;
  }
  .xp-timeline { position: relative; }
  .xp-rail { position: absolute; top: 0; bottom: 0; left: 3px; width: 1px; background: var(--line-c); transform-origin: left; }
  .xp-rail-fill { display: none; }
  .xp-column { position: relative; padding: 0 0 32px 28px; }
  .xp-column:last-child { padding-bottom: 0; }
  .xp-role { display: flex; gap: 10px; color: var(--fg); }
  .xp-index { color: var(--fg-faint); }
  .xp-node {
    position: absolute; left: 0; top: 4px;
    display: block; width: 6px; height: 6px;
    border-radius: 50%; background: var(--accent);
  }
  .xp-name { font-weight: 500; font-size: 20px; margin-top: 12px; }
  .xp-desc { color: var(--fg); line-height: 1.6; margin-top: 8px; font-size: 14px; max-width: 28ch; }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .xp-rail { top: 41px; bottom: auto; left: 0; right: 0; width: auto; height: 1px; }
    .xp-rail-fill { display: block; width: 100%; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
    .xp-columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .xp-column, .xp-column:last-child { padding: 0; }
    .xp-role { height: 30px; }
    .xp-node { position: relative; top: auto; left: auto; margin: 8px 0 20px; transition: scale .5s var(--ease-out), box-shadow .5s var(--ease-out); }
    .xp-name { margin-top: 0; }
    .xp-desc { color: var(--fg-dim); transition: color .5s var(--ease-out); }
    .xp-column:hover .xp-desc, .xp-column:focus-within .xp-desc { color: var(--fg); }
    .xp-column:hover .xp-node, .xp-column:focus-within .xp-node { scale: 1.6; box-shadow: 0 0 0 4.5px rgba(255, 79, 31, .18); }
  }
</style>
